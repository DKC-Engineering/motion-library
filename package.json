{
  "name": "@darkknightcave/motion-mcp",
  "version": "0.1.2",
  "mcpName": "co.darkknightcave/motion",
  "publishConfig": {
    "access": "public"
  },
  "description": "Search and prepare attributed motion recipes for coding agents.",
  "repository": {
    "type": "git",
    "url": "https://github.com/DKC-Engineering/motion-library.git"
  },
  "bugs": {
    "url": "https://github.com/DKC-Engineering/motion-library/issues"
  },
  "homepage": "https://darkknightcave.co/labs/motion-library",
  "type": "module",
  "types": "./dist/src/core.d.ts",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "cave-motion": "dist/src/stdio.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/core.d.ts",
      "default": "./dist/src/core.js"
    },
    "./types": {
      "types": "./dist/src/types.d.ts",
      "default": "./dist/src/types.js"
    },
    "./server": {
      "types": "./dist/src/server.d.ts",
      "default": "./dist/src/server.js"
    },
    "./catalog": "./catalog/catalog.json",
    "./recipe-ids": "./catalog/recipe-ids.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "catalog",
    "demos",
    "public",
    "docs",
    "skills",
    "src",
    "scripts",
    "test",
    "evidence",
    "tsconfig.json",
    "CONTRIBUTING.md",
    "LICENSE",
    "LICENSE-CONTENT",
    "NOTICE",
    "server.json",
    "wrangler.jsonc",
    "licenses"
  ],
  "scripts": {
    "catalog": "node scripts/build-catalog.mjs",
    "build": "npm run catalog && node scripts/prepare-assets.mjs && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "start": "node dist/src/stdio.js",
    "dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy --env ''",
    "deploy:staging": "npm run build && wrangler deploy --env staging",
    "discover": "node scripts/discover.mjs",
    "verify:demos": "node scripts/verify-demos.mjs",
    "verify:site": "node scripts/verify-site.mjs",
    "test:http": "node scripts/test-http.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "agents": "0.30.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261022.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "26.6.5",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "wrangler": "4.152.0"
  }
}
